{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@audixa/core": ["packages/core/src/index.ts"],
      "@audixa/utils": ["packages/utils/src/index.ts"],
      "@audixa/ui": ["packages/ui/src/index.ts"]
    }
  }
}
