{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Audixa",
  "version": "0.1.0",
  "identifier": "com.audixa.desktop",
  "build": {
    "frontendDist": "../../../dist/apps/desktop",
    "devUrl": "http://127.0.0.1:4201",
    "beforeDevCommand": "node -e \"\"",
    "beforeBuildCommand": "pnpm -w nx run desktop:build"
  },
  "app": {
    "windows": [
      {
        "title": "Audixa",
        "width": 960,
        "height": 720,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AGIBuild/Audixa/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
