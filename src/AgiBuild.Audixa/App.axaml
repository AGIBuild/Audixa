<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AgiBuild.Audixa"
             x:Class="AgiBuild.Audixa.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Audixa Theme Colors (based on prototype design) -->
        <Color x:Key="AudixaPrimary">#8B008B</Color>
        <Color x:Key="AudixaPrimaryDark">#5e005e</Color>
        <Color x:Key="AudixaSecondary">#DA70D6</Color>
        <Color x:Key="AudixaAccent">#FF00FF</Color>
        <Color x:Key="AudixaBgDeep">#1a051a</Color>
        <Color x:Key="AudixaBgCard">#2d0a2d</Color>
        <Color x:Key="AudixaBgPanel">#240524</Color>
        <Color x:Key="AudixaBgSidebar">#120312</Color>
        <Color x:Key="AudixaBgInput">#140f1e</Color>
        <Color x:Key="AudixaBorder">#4a1a4a</Color>
        <Color x:Key="AudixaBorderSubtle">#3a2d4a</Color>
        <Color x:Key="AudixaTextPrimary">#ffffff</Color>
        <Color x:Key="AudixaTextSecondary">#d1a3d1</Color>
        <Color x:Key="AudixaTextDim">#b08bb0</Color>
        <Color x:Key="AudixaHover">#3d1a3d</Color>
        <Color x:Key="AudixaSuccess">#10b981</Color>
        <Color x:Key="AudixaWarning">#f59e0b</Color>
        <Color x:Key="AudixaError">#ef4444</Color>

        <!-- Solid Color Brushes -->
        <SolidColorBrush x:Key="AudixaPrimaryBrush" Color="{StaticResource AudixaPrimary}"/>
        <SolidColorBrush x:Key="AudixaPrimaryDarkBrush" Color="{StaticResource AudixaPrimaryDark}"/>
        <SolidColorBrush x:Key="AudixaSecondaryBrush" Color="{StaticResource AudixaSecondary}"/>
        <SolidColorBrush x:Key="AudixaAccentBrush" Color="{StaticResource AudixaAccent}"/>
        <SolidColorBrush x:Key="AudixaBgDeepBrush" Color="{StaticResource AudixaBgDeep}"/>
        <SolidColorBrush x:Key="AudixaBgCardBrush" Color="{StaticResource AudixaBgCard}"/>
        <SolidColorBrush x:Key="AudixaBgPanelBrush" Color="{StaticResource AudixaBgPanel}"/>
        <SolidColorBrush x:Key="AudixaBgSidebarBrush" Color="{StaticResource AudixaBgSidebar}"/>
        <SolidColorBrush x:Key="AudixaBgInputBrush" Color="{StaticResource AudixaBgInput}"/>
        <SolidColorBrush x:Key="AudixaBorderBrush" Color="{StaticResource AudixaBorder}"/>
        <SolidColorBrush x:Key="AudixaBorderSubtleBrush" Color="{StaticResource AudixaBorderSubtle}"/>
        <SolidColorBrush x:Key="AudixaTextPrimaryBrush" Color="{StaticResource AudixaTextPrimary}"/>
        <SolidColorBrush x:Key="AudixaTextSecondaryBrush" Color="{StaticResource AudixaTextSecondary}"/>
        <SolidColorBrush x:Key="AudixaTextDimBrush" Color="{StaticResource AudixaTextDim}"/>
        <SolidColorBrush x:Key="AudixaHoverBrush" Color="{StaticResource AudixaHover}"/>
        <SolidColorBrush x:Key="AudixaSuccessBrush" Color="{StaticResource AudixaSuccess}"/>
        <SolidColorBrush x:Key="AudixaWarningBrush" Color="{StaticResource AudixaWarning}"/>
        <SolidColorBrush x:Key="AudixaErrorBrush" Color="{StaticResource AudixaError}"/>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="AudixaHeaderGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="{StaticResource AudixaPrimary}" Offset="0"/>
            <GradientStop Color="#4a004a" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AudixaToolbarGradient" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Color="{StaticResource AudixaBgCard}" Offset="0"/>
            <GradientStop Color="{StaticResource AudixaBgDeep}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AudixaActiveItemGradient" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Color="#668B008B" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AudixaStatCardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#9932CC" Offset="0"/>
            <GradientStop Color="{StaticResource AudixaPrimary}" Offset="1"/>
        </LinearGradientBrush>

        <!-- Border Brush with Accent Transparency -->
        <SolidColorBrush x:Key="AudixaAccentBorder20" Color="#33FF00FF"/>
        <SolidColorBrush x:Key="AudixaAccentBorder30" Color="#4DFF00FF"/>

        <!-- Common Values -->
        <CornerRadius x:Key="AudixaCardRadius">12</CornerRadius>
        <CornerRadius x:Key="AudixaSmallRadius">8</CornerRadius>
        <CornerRadius x:Key="AudixaButtonRadius">6</CornerRadius>
        <CornerRadius x:Key="AudixaCircleRadius">50</CornerRadius>
        <Thickness x:Key="AudixaCardPadding">16</Thickness>
        <Thickness x:Key="AudixaContentPadding">24</Thickness>
        <Thickness x:Key="AudixaItemPadding">12,10</Thickness>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Global Styles -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource AudixaBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaTextPrimaryBrush}"/>
        </Style>

        <Style Selector="UserControl">
            <Setter Property="Background" Value="{StaticResource AudixaBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaTextPrimaryBrush}"/>
        </Style>

        <!-- Button Styles -->
        <Style Selector="Button.audixa-primary">
            <Setter Property="Background" Value="{StaticResource AudixaAccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaTextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource AudixaButtonRadius}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.audixa-secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AudixaPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="15,6"/>
        </Style>

        <Style Selector="Button.audixa-secondary:pointerover">
            <Setter Property="Background" Value="{StaticResource AudixaPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaTextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.audixa-ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style Selector="Button.audixa-ghost:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AudixaAccentBrush}"/>
        </Style>

        <Style Selector="Button.audixa-icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style Selector="Button.audixa-icon:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AudixaAccentBrush}"/>
        </Style>

        <Style Selector="Button.audixa-play">
            <Setter Property="Background" Value="{StaticResource AudixaPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaTextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TextBox Styles -->
        <Style Selector="TextBox.audixa">
            <Setter Property="Background" Value="{StaticResource AudixaBgInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AudixaBorderBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource AudixaSmallRadius}"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style Selector="TextBox.audixa:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AudixaAccentBrush}"/>
        </Style>

        <!-- ComboBox Styles -->
        <Style Selector="ComboBox.audixa">
            <Setter Property="Background" Value="{StaticResource AudixaBgInputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AudixaBorderBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource AudixaSmallRadius}"/>
        </Style>

        <!-- Card Border Style -->
        <Style Selector="Border.audixa-card">
            <Setter Property="Background" Value="{StaticResource AudixaBgCardBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource AudixaCardRadius}"/>
            <Setter Property="Padding" Value="{StaticResource AudixaCardPadding}"/>
            <Setter Property="BorderBrush" Value="#19FF00FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.audixa-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AudixaAccentBrush}"/>
        </Style>

        <!-- Source Card Specific Style -->
        <Style Selector="Border.audixa-source-card">
            <Setter Property="Background" Value="{StaticResource AudixaBgCardBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource AudixaCardRadius}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#19FF00FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.audixa-source-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AudixaAccentBrush}"/>
        </Style>

        <!-- List Item Style -->
        <Style Selector="Border.audixa-list-item">
            <Setter Property="Background" Value="#0Dffffff"/>
            <Setter Property="CornerRadius" Value="{StaticResource AudixaSmallRadius}"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style Selector="Border.audixa-list-item:pointerover">
            <Setter Property="Background" Value="#33DA70D6"/>
        </Style>

        <!-- Section Header Style -->
        <Style Selector="TextBlock.audixa-section-title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AudixaSecondaryBrush}"/>
        </Style>

        <!-- ListBox Transparent -->
        <Style Selector="ListBox.audixa-transparent">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ListBox.audixa-transparent ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AudixaHoverBrush}"/>
        </Style>

        <Style Selector="ListBox.audixa-transparent ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AudixaPrimaryBrush}"/>
        </Style>

        <!-- Progress Bar -->
        <Style Selector="ProgressBar.audixa">
            <Setter Property="Foreground" Value="{StaticResource AudixaAccentBrush}"/>
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <!-- ScrollViewer -->
        <Style Selector="ScrollViewer.audixa">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Badge Styles -->
        <Style Selector="Border.audixa-badge">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style Selector="Border.audixa-badge-nas">
            <Setter Property="Background" Value="#005f73"/>
        </Style>

        <Style Selector="Border.audixa-badge-cloud">
            <Setter Property="Background" Value="#ca6702"/>
        </Style>

        <Style Selector="Border.audixa-badge-local">
            <Setter Property="Background" Value="#9b2226"/>
        </Style>

        <Style Selector="Border.audixa-badge-webdav">
            <Setter Property="Background" Value="#5a189a"/>
        </Style>
    </Application.Styles>
</Application>
