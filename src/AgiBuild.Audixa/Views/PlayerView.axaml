<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgiBuild.Audixa.ViewModels"
             xmlns:conv="using:AgiBuild.Audixa.Converters"
             mc:Ignorable="d"
             x:Class="AgiBuild.Audixa.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Background="{StaticResource AudixaBgDeepBrush}">
  <UserControl.Resources>
    <conv:BoolToPlayPauseTextConverter x:Key="BoolToPlayPauseTextConverter" />
  </UserControl.Resources>

  <Grid ColumnDefinitions="*,380" RowDefinitions="*,Auto">
    <!-- Video Area -->
    <Border Background="Black" Grid.Column="0" Grid.Row="0">
      <Grid>
        <ContentControl Content="{Binding VideoSurface}" />

        <!-- Floating Subtitles Overlay -->
        <StackPanel VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="24,0,24,24"
                    Spacing="8"
                    MaxWidth="800">
          <!-- Primary Subtitle (English) -->
          <Border Background="#CC000000"
                  CornerRadius="10"
                  Padding="16,10"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding DisplayedPrimaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding DisplayedPrimaryText}"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Medium"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
          </Border>
          <!-- Secondary Subtitle (Translation) -->
          <Border Background="#99000000"
                  CornerRadius="8"
                  Padding="14,8"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding DisplayedSecondaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding DisplayedSecondaryText}"
                       Foreground="#E0E0E0"
                       FontSize="17"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar: Subtitle List -->
    <Border Grid.Column="1" Grid.Row="0"
            Background="{StaticResource AudixaBgDeepBrush}"
            BorderBrush="{StaticResource AudixaBorderSubtleBrush}"
            BorderThickness="1,0,0,0">
      <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Padding="18,14"
                BorderBrush="{StaticResource AudixaBorderSubtleBrush}"
                BorderThickness="0,0,0,1">
          <DockPanel>
            <TextBlock Text="Subtitles"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AudixaTextPrimaryBrush}"/>
            <Border DockPanel.Dock="Right"
                    Background="{StaticResource AudixaPrimaryBrush}"
                    CornerRadius="4"
                    Padding="8,4">
              <TextBlock Text="SRT/VTT"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="{StaticResource AudixaAccentBrush}"/>
            </Border>
          </DockPanel>
        </Border>

        <!-- Subtitle List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SubtitleRows}"
                        Margin="10">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlayerViewModel+SubtitleRowViewModel">
                <Button Command="{Binding SeekCommand}"
                        CommandParameter="{Binding .}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0,0,0,6"
                        HorizontalContentAlignment="Stretch">
                  <Border Padding="14,12"
                          CornerRadius="10"
                          Background="{StaticResource AudixaBgCardBrush}"
                          BorderThickness="4,0,0,0">
                    <Border.BorderBrush>
                      <SolidColorBrush Color="Transparent"/>
                    </Border.BorderBrush>
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Start, StringFormat={}{0:mm\\:ss}}"
                                 FontSize="11"
                                 FontFamily="Consolas, monospace"
                                 Foreground="{StaticResource AudixaTextDimBrush}"/>
                      <TextBlock Text="{Binding PrimaryText}"
                                 FontSize="14"
                                 Foreground="{StaticResource AudixaTextPrimaryBrush}"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding SecondaryText}"
                                 FontSize="13"
                                 Foreground="{StaticResource AudixaTextSecondaryBrush}"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Controls Bar -->
    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
            Background="{StaticResource AudixaBgCardBrush}"
            BorderBrush="{StaticResource AudixaBorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,16">
      <StackPanel Spacing="14">
        <!-- Timeline -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding State.Position, StringFormat={}{0:mm\\:ss}}"
                     FontFamily="Consolas, monospace"
                     FontSize="12"
                     Foreground="{StaticResource AudixaTextDimBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <Border Grid.Column="1"
                  Height="6"
                  Background="#555555"
                  CornerRadius="3"
                  VerticalAlignment="Center">
            <Border Background="{StaticResource AudixaAccentBrush}"
                    CornerRadius="3"
                    HorizontalAlignment="Left"
                    Width="150"/>
          </Border>
          <TextBlock Grid.Column="2"
                     Text="{Binding State.Duration, StringFormat={}{0:mm\\:ss}}"
                     FontFamily="Consolas, monospace"
                     FontSize="12"
                     Foreground="{StaticResource AudixaTextDimBrush}"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0"/>
        </Grid>

        <!-- Control Buttons -->
        <DockPanel>
          <!-- Left: Mask & Subtitle Controls -->
          <StackPanel DockPanel.Dock="Left"
                      Orientation="Horizontal"
                      Spacing="8">
            <Button Content="👁️ Mask"
                    Classes="audixa-secondary"
                    Command="{Binding ToggleMaskCommand}"/>
            <Button Content="📝 Primary"
                    Classes="audixa-ghost"
                    Command="{Binding LoadPrimarySubtitleCommand}"/>
            <Button Content="🌐 Secondary"
                    Classes="audixa-ghost"
                    Command="{Binding LoadSecondarySubtitleCommand}"/>

            <Border Background="{StaticResource AudixaBgInputBrush}"
                    CornerRadius="6"
                    Padding="4">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="-"
                        Classes="audixa-icon"
                        Command="{Binding AdjustPrimaryOffsetCommand}"
                        CommandParameter="-500"
                        Width="28" Height="28"/>
                <TextBlock Text="{Binding PrimaryOffsetMs, StringFormat={}{0}ms}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource AudixaTextDimBrush}"
                           MinWidth="50"
                           TextAlignment="Center"/>
                <Button Content="+"
                        Classes="audixa-icon"
                        Command="{Binding AdjustPrimaryOffsetCommand}"
                        CommandParameter="500"
                        Width="28" Height="28"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Right: Extra Controls -->
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Spacing="8">
            <Button Content="🅰️🅱️ AB"
                    Classes="audixa-ghost"/>

            <Border Background="{StaticResource AudixaBgInputBrush}"
                    CornerRadius="6"
                    Padding="8,4">
              <TextBlock Text="{Binding State.Speed, StringFormat={}{0:0.0}x}"
                         FontSize="13"
                         Foreground="{StaticResource AudixaTextPrimaryBrush}"
                         VerticalAlignment="Center"/>
            </Border>

            <Button Content="💾 Save"
                    Classes="audixa-primary"
                    Command="{Binding SaveCurrentSentenceCommand}"/>
          </StackPanel>

          <!-- Center: Playback Controls -->
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="16">
            <Button Content="⏮"
                    Classes="audixa-icon"
                    FontSize="20"/>
            <Button Classes="audixa-play"
                    Command="{Binding TogglePlayPauseCommand}">
              <TextBlock Text="{Binding State.IsPlaying, Converter={StaticResource BoolToPlayPauseTextConverter}}"
                         FontSize="18"/>
            </Button>
            <Button Content="⏭"
                    Classes="audixa-icon"
                    FontSize="20"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
