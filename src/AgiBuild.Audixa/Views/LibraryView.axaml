<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgiBuild.Audixa.ViewModels"
             xmlns:domain="using:AgiBuild.Audixa.Domain"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             xmlns:conv="using:AgiBuild.Audixa.Converters"
             mc:Ignorable="d"
             x:Class="AgiBuild.Audixa.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             Background="{StaticResource AudixaBgDeepBrush}">
  <UserControl.Resources>
    <conv:IsDirectoryToIconConverter x:Key="IsDirToIconConverter" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
  </UserControl.Resources>

  <ScrollViewer x:Name="RootScroll" ScrollChanged="RootScroll_OnScrollChanged">
    <Border Padding="28,24">
      <StackPanel Spacing="24">

        <!-- Section: Add Source -->
        <StackPanel Spacing="16">
          <Border BorderBrush="{StaticResource AudixaAccentBrush}"
                  BorderThickness="4,0,0,0"
                  Padding="12,0,0,0">
            <TextBlock Text="Add Source"
                       Classes="audixa-section-title"/>
          </Border>

          <!-- Source Cards Grid -->
          <primitives:UniformGrid Columns="4" Rows="1" HorizontalAlignment="Stretch">
            <!-- Local Storage Card -->
            <Button Command="{Binding OpenLocalMp4Command}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0,0,12,0"
                    HorizontalContentAlignment="Stretch">
              <Border Classes="audixa-source-card">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                  <Border Width="56" Height="56"
                          Background="#1Affffff"
                          CornerRadius="28"
                          HorizontalAlignment="Center">
                    <TextBlock Text="📂"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Local Storage"
                             FontWeight="Medium"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Device Files"
                             Foreground="{StaticResource AudixaTextSecondaryBrush}"
                             FontSize="12"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Button>

            <!-- SMB / NAS Card -->
            <Button Command="{Binding ToggleSmbPanelCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0,0,12,0"
                    HorizontalContentAlignment="Stretch">
              <Border Classes="audixa-source-card">
                <Border.Styles>
                  <Style Selector="Border.audixa-source-card">
                    <Setter Property="BorderBrush" Value="#19FF00FF"/>
                  </Style>
                </Border.Styles>
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                  <Border Width="56" Height="56"
                          Background="#1Affffff"
                          CornerRadius="28"
                          HorizontalAlignment="Center">
                    <TextBlock Text="🖥️"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="SMB / NAS"
                             FontWeight="Medium"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Home Server"
                             Foreground="{StaticResource AudixaTextSecondaryBrush}"
                             FontSize="12"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Button>

            <!-- WebDAV Card (Coming Soon) -->
            <Border Classes="audixa-source-card"
                    Opacity="0.4"
                    Margin="0,0,12,0">
              <StackPanel HorizontalAlignment="Center" Spacing="10">
                <Border Width="56" Height="56"
                        Background="#1Affffff"
                        CornerRadius="28"
                        HorizontalAlignment="Center">
                  <TextBlock Text="☁️"
                             FontSize="26"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="WebDAV"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="v1+"
                           Foreground="{StaticResource AudixaTextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- Subtitle Search Card (Coming Soon) -->
            <Border Classes="audixa-source-card"
                    Opacity="0.4">
              <StackPanel HorizontalAlignment="Center" Spacing="10">
                <Border Width="56" Height="56"
                        Background="#1Affffff"
                        CornerRadius="28"
                        HorizontalAlignment="Center">
                  <TextBlock Text="🌐"
                             FontSize="26"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Subtitle Search"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="v1+"
                           Foreground="{StaticResource AudixaTextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </primitives:UniformGrid>
        </StackPanel>

        <!-- SMB / NAS Expandable Panel -->
        <Border IsVisible="{Binding IsSmbPanelExpanded}"
                Classes="audixa-card"
                Padding="0"
                BorderBrush="{StaticResource AudixaAccentBorder30}">
          <StackPanel>
            <!-- Panel Header -->
            <Border Background="{StaticResource AudixaHeaderGradient}"
                    CornerRadius="12,12,0,0"
                    Padding="20,14">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="🖥️" FontSize="20" VerticalAlignment="Center"/>
                  <TextBlock Text="SMB / NAS Configuration"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AudixaTextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Classes="audixa-icon"
                        FontSize="16"
                        Command="{Binding ToggleSmbPanelCommand}"
                        HorizontalAlignment="Right"/>
              </DockPanel>
            </Border>

            <!-- Panel Content -->
            <StackPanel Spacing="18" Margin="20">
              <!-- SMB Profile Selector -->
              <StackPanel Spacing="10">
                <TextBlock Text="Saved Profiles"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource AudixaTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ComboBox Width="360"
                            Classes="audixa"
                            ItemsSource="{Binding SmbProfileList}"
                            SelectedItem="{Binding SelectedSmbProfile}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="↻"
                          Classes="audixa-icon"
                          FontSize="16"
                          Command="{Binding RefreshSmbProfilesCommand}"
                          ToolTip.Tip="Refresh profiles"/>
                </StackPanel>
              </StackPanel>

              <!-- Connection Form -->
              <Border Background="{StaticResource AudixaBgInputBrush}"
                      CornerRadius="10"
                      Padding="18">
                <StackPanel Spacing="14">
                  <TextBlock Text="Connection Settings"
                             FontSize="14"
                             FontWeight="Medium"
                             Foreground="{StaticResource AudixaTextSecondaryBrush}"/>

                  <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             Classes="audixa"
                             Text="{Binding NewSmbRootPath}"
                             Watermark="\\server\share or smb://server/share"/>
                    <TextBox Grid.Column="1"
                             Classes="audixa"
                             Text="{Binding NewSmbUsername}"
                             Watermark="Username (optional)"/>
                    <TextBox Grid.Column="2"
                             Width="120"
                             Classes="audixa"
                             Text="{Binding NewSmbDomain}"
                             Watermark="Domain"/>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBox Width="200"
                             Classes="audixa"
                             Text="{Binding NewSmbPassword}"
                             Watermark="Password"
                             PasswordChar="•"/>
                    <CheckBox Content="Remember password"
                              IsChecked="{Binding RememberSmbPassword}"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource AudixaTextSecondaryBrush}"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <Button Content="Save New"
                            Classes="audixa-primary"
                            Command="{Binding SaveSmbProfileCommand}"
                            IsEnabled="{Binding IsSmbLoading, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Update"
                            Classes="audixa-secondary"
                            Command="{Binding UpdateSelectedSmbProfileCommand}"
                            IsEnabled="{Binding IsSmbLoading, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Delete"
                            Classes="audixa-secondary"
                            Command="{Binding DeleteSelectedSmbProfileCommand}"
                            IsEnabled="{Binding IsSmbLoading, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Browse →"
                            Classes="audixa-primary"
                            Command="{Binding BrowseSmbCommand}"
                            IsEnabled="{Binding IsSmbLoading, Converter={StaticResource InverseBool}}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- SMB Browser Section -->
              <StackPanel Spacing="12"
                          IsVisible="{Binding CurrentSmbPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Border BorderBrush="{StaticResource AudixaBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,16,0,0">
                  <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="↻"
                            Classes="audixa-icon"
                            FontSize="16"
                            Command="{Binding RefreshSmbListingCommand}"
                            IsEnabled="{Binding IsSmbLoading, Converter={StaticResource InverseBool}}"
                            ToolTip.Tip="Refresh"/>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Current Path"
                                 FontSize="12"
                                 Foreground="{StaticResource AudixaTextDimBrush}"/>
                      <TextBlock Text="{Binding CurrentSmbPath}"
                                 FontSize="13"
                                 Foreground="{StaticResource AudixaTextSecondaryBrush}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>

                <TextBlock Text="{Binding SmbLoadedCount, StringFormat={}{0} items}"
                           Foreground="{StaticResource AudixaTextDimBrush}"
                           FontSize="12"/>

                <ProgressBar IsVisible="{Binding IsSmbLoading}"
                             IsIndeterminate="True"
                             Classes="audixa"/>

                <!-- SMB File List -->
                <Border Background="{StaticResource AudixaBgInputBrush}"
                        CornerRadius="10"
                        Padding="8"
                        MaxHeight="320">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SmbEntries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryViewModel+SmbEntryViewModel">
                          <Button Command="{Binding OpenCommand}"
                                  CommandParameter="{Binding .}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="12,10"
                                  HorizontalContentAlignment="Stretch"
                                  IsEnabled="{Binding $parent[ItemsControl].DataContext.IsSmbLoading, Converter={StaticResource InverseBool}}">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Left"
                                         Text="{Binding IsDirectory, Converter={StaticResource IsDirToIconConverter}}"
                                         FontSize="18"
                                         Margin="0,0,14,0"
                                         VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Name}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>

                <Button Content="Load more"
                        Classes="audixa-secondary"
                        Command="{Binding LoadMoreSmbCommand}"
                        IsVisible="{Binding CanLoadMoreSmbEntries}"
                        IsEnabled="{Binding IsSmbLoading, Converter={StaticResource InverseBool}}"
                        HorizontalAlignment="Left"/>

                <TextBlock Text="Loading more…"
                           IsVisible="{Binding IsSmbLoadingMore}"
                           Foreground="{StaticResource AudixaTextDimBrush}"
                           FontSize="12"/>

                <!-- SMB Load Error -->
                <Border Background="{StaticResource AudixaBgInputBrush}"
                        CornerRadius="8"
                        Padding="14"
                        IsVisible="{Binding SmbLoadMoreError, Converter={StaticResource IsNotNullConverter}}"
                        BorderBrush="{StaticResource AudixaErrorBrush}"
                        BorderThickness="1">
                  <DockPanel>
                    <StackPanel>
                      <TextBlock Text="Load failed"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource AudixaErrorBrush}"/>
                      <TextBlock Text="{Binding SmbLoadMoreError}"
                                 Foreground="{StaticResource AudixaTextDimBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Retry"
                            Classes="audixa-secondary"
                            Command="{Binding LoadMoreSmbCommand}"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Section: Continue Learning -->
        <StackPanel Spacing="16">
          <DockPanel>
            <Border BorderBrush="{StaticResource AudixaAccentBrush}"
                    BorderThickness="4,0,0,0"
                    Padding="12,0,0,0">
              <TextBlock Text="Continue Learning"
                         Classes="audixa-section-title"/>
            </Border>
            <Button DockPanel.Dock="Right"
                    Content="↻ Refresh"
                    Classes="audixa-ghost"
                    Command="{Binding RefreshRecentsCommand}"
                    HorizontalAlignment="Right"/>
          </DockPanel>

          <!-- Recent Items List -->
          <Border Classes="audixa-card" Padding="12">
            <ItemsControl ItemsSource="{Binding RecentItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:MediaItem">
                  <Button Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenRecentCommand}"
                          CommandParameter="{Binding .}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          Margin="0,0,0,8"
                          HorizontalContentAlignment="Stretch">
                    <Border Classes="audixa-list-item">
                      <DockPanel>
                        <!-- Play Icon -->
                        <TextBlock DockPanel.Dock="Left"
                                   Text="▶️"
                                   FontSize="16"
                                   Margin="0,0,16,0"
                                   Foreground="{StaticResource AudixaSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- Progress Bar -->
                        <Border DockPanel.Dock="Right"
                                Width="100"
                                Height="6"
                                Background="#444444"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                          <Border Background="{StaticResource AudixaAccentBrush}"
                                  CornerRadius="3"
                                  HorizontalAlignment="Left"
                                  Width="45"/>
                        </Border>

                        <!-- File Info -->
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource AudixaTextPrimaryBrush}"/>
                          <TextBlock Text="{Binding SourceLocator}"
                                     Foreground="{StaticResource AudixaTextSecondaryBrush}"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
