<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgiBuild.Audixa.ViewModels"
             xmlns:views="using:AgiBuild.Audixa.Views"
             mc:Ignorable="d"
             x:Class="AgiBuild.Audixa.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- Header Navigation with Gradient -->
    <Border Background="{StaticResource AudixaHeaderGradient}"
            Padding="20,14"
            BoxShadow="0 4 15 0 #80000000">
      <DockPanel LastChildFill="True">
        <!-- Logo -->
        <StackPanel DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="⚡"
                     FontSize="24"
                     Foreground="{StaticResource AudixaAccentBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock Text="Audixa"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="{StaticResource AudixaTextPrimaryBrush}"
                     VerticalAlignment="Center"
                     LetterSpacing="1"/>
        </StackPanel>

        <!-- Navigation Tabs -->
        <ItemsControl DockPanel.Dock="Right"
                      ItemsSource="{Binding Pages}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel+NavigationItem">
              <Button Command="{Binding NavigateCommand}"
                      CommandParameter="{Binding ViewModel}"
                      Classes="audixa-ghost"
                      Padding="14,8">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="Medium"/>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Spacer -->
        <Panel/>
      </DockPanel>
    </Border>

    <!-- Content + Overlays -->
    <Grid Grid.Row="1">
      <Grid RowDefinitions="*,Auto">
        <!-- Main Content Area -->
        <ContentControl Content="{Binding CurrentPage}"
                        Background="{StaticResource AudixaBgDeepBrush}"/>

        <!-- Mini Player -->
        <views:MiniPlayerView Grid.Row="1" DataContext="{Binding MiniPlayer}"/>
      </Grid>

      <!-- Notifications Overlay -->
      <views:NotificationHostView DataContext="{Binding Notifications}"/>
    </Grid>
  </Grid>
</UserControl>
