<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgiBuild.Audixa.ViewModels"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             mc:Ignorable="d"
             x:Class="AgiBuild.Audixa.Views.LearningView"
             x:DataType="vm:LearningViewModel"
             Background="{StaticResource AudixaBgDeepBrush}">

  <ScrollViewer>
    <Border Padding="28,24">
      <StackPanel Spacing="28">

        <!-- Header -->
        <Border BorderBrush="{StaticResource AudixaAccentBrush}"
                BorderThickness="4,0,0,0"
                Padding="12,0,0,0">
          <TextBlock Text="Learning"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="{StaticResource AudixaTextPrimaryBrush}"/>
        </Border>

        <!-- Stats Cards -->
        <primitives:UniformGrid Columns="3" Rows="1" HorizontalAlignment="Stretch">
          <!-- Saved Sentences -->
          <Border Background="{StaticResource AudixaStatCardGradient}"
                  CornerRadius="14"
                  Padding="20"
                  Margin="0,0,14,0">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SavedSentenceCount}"
                         FontSize="36"
                         FontWeight="Bold"
                         Foreground="{StaticResource AudixaTextPrimaryBrush}"/>
              <TextBlock Text="Saved Sentences"
                         FontSize="14"
                         Foreground="{StaticResource AudixaTextPrimaryBrush}"
                         Opacity="0.85"/>
            </StackPanel>
          </Border>

          <!-- Vocabulary -->
          <Border Background="{StaticResource AudixaStatCardGradient}"
                  CornerRadius="14"
                  Padding="20"
                  Margin="0,0,14,0">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding VocabularyCount}"
                         FontSize="36"
                         FontWeight="Bold"
                         Foreground="{StaticResource AudixaTextPrimaryBrush}"/>
              <TextBlock Text="Vocabulary Items"
                         FontSize="14"
                         Foreground="{StaticResource AudixaTextPrimaryBrush}"
                         Opacity="0.85"/>
            </StackPanel>
          </Border>

          <!-- Weekly Time -->
          <Border Background="{StaticResource AudixaStatCardGradient}"
                  CornerRadius="14"
                  Padding="20">
            <StackPanel Spacing="6">
              <TextBlock Text="12h"
                         FontSize="36"
                         FontWeight="Bold"
                         Foreground="{StaticResource AudixaTextPrimaryBrush}"/>
              <TextBlock Text="Weekly Time"
                         FontSize="14"
                         Foreground="{StaticResource AudixaTextPrimaryBrush}"
                         Opacity="0.85"/>
            </StackPanel>
          </Border>
        </primitives:UniformGrid>

        <!-- Add Word Section -->
        <Border Classes="audixa-card" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="Add to Vocabulary"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AudixaTextPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBox Width="300"
                       Classes="audixa"
                       Text="{Binding NewWord}"
                       Watermark="Enter a word or phrase..."/>
              <Button Content="+ Add"
                      Classes="audixa-primary"
                      Command="{Binding AddWordCommand}"/>
              <Button Content="↻ Refresh"
                      Classes="audixa-ghost"
                      Command="{Binding RefreshCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Recent Saved Sentences -->
        <StackPanel Spacing="14">
          <Border BorderBrush="{StaticResource AudixaAccentBrush}"
                  BorderThickness="4,0,0,0"
                  Padding="12,0,0,0">
            <TextBlock Text="Recent Saved"
                       Classes="audixa-section-title"/>
          </Border>

          <Border Classes="audixa-card" Padding="16">
            <ItemsControl ItemsSource="{Binding RecentSavedSentences}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,14"
                          Padding="16,12"
                          Background="#1Affffff"
                          CornerRadius="10"
                          BorderBrush="{StaticResource AudixaPrimaryBrush}"
                          BorderThickness="0,0,0,0">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding PrimaryText}"
                                 FontSize="16"
                                 FontWeight="Medium"
                                 Foreground="{StaticResource AudixaTextPrimaryBrush}"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding SecondaryText}"
                                 FontSize="14"
                                 Foreground="{StaticResource AudixaTextSecondaryBrush}"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- Two Column Layout: Sentences & Vocabulary -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
          <!-- Saved Sentences Column -->
          <StackPanel Grid.Column="0" Spacing="14">
            <Border BorderBrush="{StaticResource AudixaAccentBrush}"
                    BorderThickness="4,0,0,0"
                    Padding="12,0,0,0">
              <TextBlock Text="Saved Sentences"
                         Classes="audixa-section-title"/>
            </Border>

            <Border Classes="audixa-card" Padding="14" MinHeight="200">
              <ItemsControl ItemsSource="{Binding SavedSentences}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,12"
                            Padding="14,10"
                            Background="#1Affffff"
                            CornerRadius="8">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding PrimaryText}"
                                   FontSize="14"
                                   Foreground="{StaticResource AudixaTextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SecondaryText}"
                                   FontSize="13"
                                   Foreground="{StaticResource AudixaTextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <!-- Vocabulary Column -->
          <StackPanel Grid.Column="1" Spacing="14">
            <Border BorderBrush="{StaticResource AudixaAccentBrush}"
                    BorderThickness="4,0,0,0"
                    Padding="12,0,0,0">
              <TextBlock Text="Vocabulary Book"
                         Classes="audixa-section-title"/>
            </Border>

            <Border Classes="audixa-card" Padding="14" MinHeight="200">
              <ItemsControl ItemsSource="{Binding VocabularyItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="14,12"
                            Background="{StaticResource AudixaBgCardBrush}"
                            BorderBrush="{StaticResource AudixaPrimaryBrush}"
                            BorderThickness="4,0,0,0"
                            CornerRadius="8">
                      <DockPanel>
                        <TextBlock Text="{Binding Word}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AudixaAccentBrush}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Content="🔊"
                                Classes="audixa-icon"
                                HorizontalAlignment="Right"/>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </Grid>

      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
