<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgiBuild.Audixa.ViewModels"
             xmlns:conv="using:AgiBuild.Audixa.Converters"
             mc:Ignorable="d"
             x:Class="AgiBuild.Audixa.Views.NotificationHostView"
             x:DataType="vm:NotificationHostViewModel">
  <UserControl.Resources>
    <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
  </UserControl.Resources>

  <Grid>
    <!-- Top Alert Bar (System Critical) -->
    <Border VerticalAlignment="Top"
            Background="{StaticResource AudixaWarningBrush}"
            IsVisible="{Binding TopAlertMessage, Converter={StaticResource IsNotNullConverter}}"
            Padding="12,10">
      <Border.Effect>
        <DropShadowEffect BlurRadius="10"
                          Color="Black"
                          OffsetX="0"
                          OffsetY="2"
                          Opacity="0.3"/>
      </Border.Effect>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left"
                   Text="⚠️"
                   FontSize="16"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TopAlertMessage}"
                   Foreground="Black"
                   FontWeight="Bold"
                   FontSize="14"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Toast Stack -->
    <ItemsControl ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,24,100">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastViewModel">
          <Border Background="#E62d0a2d"
                  BorderBrush="#1Affffff"
                  BorderThickness="1,1,1,1"
                  CornerRadius="8"
                  Padding="16,14"
                  MinWidth="280"
                  MaxWidth="360">
            <Border.Effect>
              <DropShadowEffect BlurRadius="20"
                                Color="Black"
                                OffsetX="0"
                                OffsetY="5"
                                Opacity="0.5"/>
            </Border.Effect>
            <!-- Left Accent Border -->
            <Grid>
              <Border HorizontalAlignment="Left"
                      Margin="-16,-14,-16,-14"
                      Width="4"
                      Background="{StaticResource AudixaAccentBrush}"
                      CornerRadius="8,0,0,8"/>
              <DockPanel Margin="12,0,0,0">
                <!-- Icon -->
                <Border DockPanel.Dock="Left"
                        Width="32"
                        Height="32"
                        Background="#1Affffff"
                        CornerRadius="16"
                        Margin="0,0,14,0">
                  <TextBlock Text="{Binding Icon}"
                             FontSize="14"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <!-- Content -->
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Title}"
                             FontWeight="SemiBold"
                             FontSize="14"
                             Foreground="{StaticResource AudixaTextPrimaryBrush}"/>
                  <TextBlock Text="{Binding Message}"
                             FontSize="13"
                             Foreground="{StaticResource AudixaTextSecondaryBrush}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
